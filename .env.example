# --- Maps (required for MapTiler dark tiles + geocoding; falls back to CARTO/OSM without it)
# Exposed to the browser for map tiles — restrict the key to your domains in the MapTiler dashboard.
MAPTILE_API_KEY=your-maptiler-key

# --- Server
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
# OSRM_URL=https://router.project-osrm.org      # self-host OSRM for production traffic
# DATA_DIR=server/data                           # where the SQLite file lives

# --- Ride rules
# DISPATCH_RADIUS_KM=6        # how far away drivers can receive a request
# REQUEST_TTL_SECONDS=180     # unanswered requests expire to "no driver found"

# --- Simulated bot drivers (demo mode)
# SIM_BOTS=true               # set to false to only use real driver accounts
# SIM_SPEED_MPS=40            # minimum bot driving speed in metres/second (sped up for demos)
# SIM_PICKUP_MAX_SECONDS=15   # longest a bot takes to reach the pickup, whatever the distance
# SIM_TRIP_MAX_SECONDS=25     # longest a simulated trip takes to reach the destination
# SIM_HUMAN_GRACE_SECONDS=20  # bots wait this long when a real driver is nearby

# --- Email (optional). Without SMTP, emails are stored and shown in Admin → Emails.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="RideFlow <no-reply@example.com>"
