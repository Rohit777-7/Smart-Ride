{
  "name": "rideflow",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --experimental-sqlite --disable-warning=ExperimentalWarning --watch server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node --experimental-sqlite --disable-warning=ExperimentalWarning server/index.js",
    "db:reset": "node -e \"require('fs').rmSync('server/data',{recursive:true,force:true});console.log('Database removed â€” it will be re-seeded on next start')\"",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "gsap": "^3.15.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.74.0",
    "maplibre-gl": "^6.19.0",
    "nodemailer": "^10.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "vite": "^8.3.6"
  },
  "engines": {
    "node": ">=22.5"
  }
}
